define bot refuse research input
  "I can only help with questions about the uploaded research paper."

define bot refuse research output
  "I couldn't verify an answer from the paper. Please try rephrasing your question."

define flow check research input
  $input_allowed = execute research_input_check
  if not $input_allowed
    bot refuse research input
    stop

define flow check research output
  $output_allowed = execute research_output_check
  if not $output_allowed
    bot refuse research output
    stop
