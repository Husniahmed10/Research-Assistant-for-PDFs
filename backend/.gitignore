# =============================================================================
# .gitignore — Files to never commit to Git
# =============================================================================

# Environment & Secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.pyc
*.pyi

# Virtual Environments
venv/
.venv/
env/
ENV/
.virtualenv/

# SQLite Database
*.db
*.sqlite
*.sqlite3

# Uploaded Files (don't commit user uploads)
uploads/*
!uploads/.gitkeep

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# LangSmith / Logfire local caches
.langchain/

