# =============================================================================
# .env.example — Safe template to commit to Git
# Copy to .env and fill in your real values
# =============================================================================

APP_NAME="Research Assistant for PDFs"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=llama-3.1-70b-versatile

PORTKEY_API_KEY=pk-your-key-here
# Saved OpenAI -> Groq fallback config; required if inline configs are blocked.
PORTKEY_CONFIG_ID=
PORTKEY_VIRTUAL_KEY_OPENAI=your-virtual-key
PORTKEY_VIRTUAL_KEY_GROQ=your-virtual-key

PINECONE_API_KEY=pcsk-your-key-here
PINECONE_INDEX_NAME=research-assistant
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=1536

COHERE_API_KEY=your-key-here
COHERE_RERANK_MODEL=rerank-english-v3.0
FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2
FLASHRANK_CACHE_DIR=.cache/flashrank

DATABASE_URL=sqlite+aiosqlite:///./research_assistant.db

LANGCHAIN_API_KEY=ls-your-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=research-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

LOGFIRE_TOKEN=your-token-here

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
HYBRID_ALPHA=0.7

